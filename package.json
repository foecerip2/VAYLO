{
  "name": "vpn-platform",
  "version": "1.0.0",
  "description": "VAYLO — self-hosted platform for selling VPN subscriptions on Remnawave: Telegram bot, Mini App, admin panel, installers",
  "private": true,
  "license": "MIT",
  "author": "Sergey (VAYLO)",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @vpn/api dev",
    "dev:bot": "pnpm --filter @vpn/bot dev",
    "dev:app": "pnpm --filter @vpn/app dev",
    "dev:admin": "pnpm --filter @vpn/admin dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "sharp"
    ]
  }
}
