# Скопируйте в .env или используйте scripts/install.sh — он заполнит всё сам.

# --- Домены (без https://) ---
APP_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com

# --- Секреты (openssl rand -hex 32) ---
DB_PASSWORD=change-me
APP_SECRET=change-me-change-me-change-me-change-me
INTERNAL_KEY=change-me
WEBHOOK_SECRET=change-me

# --- Telegram ---
BOT_TOKEN=123456:ABC
BOT_USERNAME=my_vpn_bot

# --- Публичные адреса ---
API_URL=https://app.example.com
APP_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
WEBHOOK_URL=https://app.example.com/tg/webhook

# --- Внутренние адреса (не менять при установке через compose) ---
NODE_ENV=production
DATABASE_URL=postgres://vpn:change-me@postgres:5432/vpn
REDIS_URL=redis://redis:6379
API_INTERNAL_URL=http://api:3000

# --- Remnawave ---
REMNAWAVE_URL=http://remnawave:3000
REMNAWAVE_TOKEN=
REMNAWAVE_SQUAD_UUID=

# --- LTE: заполняется connect-lte.sh / connect-lte-remote.sh ---
LTE_DATABASE_URL=
LTE_NODE_ID=2
# С какого дня эта нода обслуживает только LTE (история активности; не меняет расчёт квоты)
LTE_ACTIVITY_START_DATE=2026-10-25

# --- Feature flags новых модулей (true/false, по умолчанию выключены) ---
# true: /net/probe-report принимает ТОЛЬКО выпущенные токены проб (x-probe-token), общий INTERNAL_KEY отключается
NETPROBE_SCOPED_AUTH=false
NETWORK_INTELLIGENCE_ENABLED=false
NETWORK_INCIDENT_ALERTS_ENABLED=false
NODE_RECOMMENDATIONS_ENABLED=false
PRODUCT_ANALYTICS_ENABLED=false
SUPPORT_AI_KNOWLEDGE_ENABLED=false
UI_V2_ENABLED=false
# Уведомления пользователям бота о подтверждённых сбоях у их оператора
NETWORK_USER_NOTICES_ENABLED=false
