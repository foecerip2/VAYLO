{
	# HTTP/3 (QUIC, UDP 443) отключён: на многих домашних Wi-Fi-роутерах и у ряда провайдеров UDP режется или душится,
	# из-за чего сайт «еле грузится» по Wi-Fi, а по мобильной сети работает нормально. HTTP/2 по TCP стабилен везде.
	servers {
		protocols h1 h2
	}
}

# Шлюз: HTTPS-сертификаты Let's Encrypt выпускаются автоматически.
# Домены берутся из переменных окружения (см. .env).

(security) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(spa) {
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html not path /assets/*
	header @html Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

{$APP_DOMAIN} {
	import security
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:3000
	}
	handle /tg/webhook {
		reverse_proxy bot:3001
	}
	handle {
		root * /srv/app
		import spa
	}
}

{$ADMIN_DOMAIN} {
	import security
	header X-Frame-Options DENY
	encode zstd gzip
	handle /api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/admin
		import spa
	}
}

# Дополнительные сайты (панель Remnawave, страница подписок) подключаются установщиком
import /etc/caddy/conf.d/*
