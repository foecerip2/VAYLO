{
  "name": "@vpn/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file=../../.env src/worker.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "bullmq": "^5.30.0",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "postgres": "^3.4.5",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@remnawave/backend-contract": "3.4.15",
    "@types/node": "^22.9.0",
    "@vpn/shared": "workspace:*",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
